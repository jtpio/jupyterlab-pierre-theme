{
    "name": "jupyterlab-pierre-theme-root",
    "version": "0.1.1",
    "private": true,
    "description": "JupyterLab themes matching the Pierre palette",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension",
        "theme",
        "pierre"
    ],
    "homepage": "https://github.com/jtpio/jupyterlab-pierre-theme",
    "bugs": {
        "url": "https://github.com/jtpio/jupyterlab-pierre-theme/issues"
    },
    "license": "BSD-3-Clause",
    "author": "Jeremy Tuloup",
    "repository": {
        "type": "git",
        "url": "https://github.com/jtpio/jupyterlab-pierre-theme.git"
    },
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "generate": "node scripts/generate-theme.mjs",
        "build": "pnpm generate && pnpm -r run build",
        "build:prod": "pnpm generate && pnpm -r run build:prod",
        "clean": "pnpm -r run clean",
        "clean:all": "pnpm -r run clean:all && pnpm clean:lintcache",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "eslint": "pnpm eslint:check --fix",
        "eslint:check": "eslint . --cache",
        "lint": "pnpm stylelint && pnpm prettier && pnpm eslint",
        "lint:check": "pnpm stylelint:check && pnpm prettier:check && pnpm eslint:check",
        "prettier": "pnpm prettier:base --write --list-different",
        "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.mjs,.jsx,.css,.json,.md}\"",
        "prettier:check": "pnpm prettier:base --check",
        "stylelint": "pnpm stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"packages/*/style/**/*.css\"",
        "watch": "pnpm -r --parallel run watch"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jupyter/builder": "^1.2.2",
        "@jupyter/eslint-plugin": "^1.1.0",
        "@pierre/theme": "^2.0.0",
        "@types/json-schema": "^7.0.15",
        "@types/react": "^19.2.18",
        "css-loader": "^7.1.4",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "style-loader": "^4.0.0",
        "stylelint": "^17.14.1",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-csstree-validator": "^4.0.0",
        "stylelint-prettier": "^5.0.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.67.0",
        "yjs": "^13.6.32"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$",
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null,
            "alpha-value-notation": null,
            "color-function-alias-notation": null,
            "color-function-notation": null,
            "custom-property-pattern": null
        }
    },
    "jupyter-releaser": {
        "options": {
            "version-cmd": "hatch version",
            "python-packages": [
                "packages/jupyterlab-pierre-dark:jupyterlab_pierre_dark",
                "packages/jupyterlab-pierre-light:jupyterlab_pierre_light"
            ],
            "pydist-extra-check-cmds": [
                "pipx run 'validate-pyproject[all]' packages/*/pyproject.toml",
                "pipx run check-wheel-contents --config packages/jupyterlab-pierre-dark/pyproject.toml {dist_dir}/jupyterlab_pierre_dark*.whl",
                "pipx run check-wheel-contents --config packages/jupyterlab-pierre-light/pyproject.toml {dist_dir}/jupyterlab_pierre_light*.whl"
            ]
        },
        "hooks": {
            "after-bump-version": [
                "python scripts/sync_version.py"
            ],
            "before-build-npm": [
                "python -m pip install 'jupyter-builder>=1.2.2,<2'",
                "npm install -g pnpm@10.28.0",
                "pnpm install",
                "pnpm build:prod"
            ],
            "before-build-python": [
                "pnpm clean:all"
            ]
        }
    }
}
